# Copy this file to .env and fill in real values before running the server.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/resume_screening

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
TEMP_TOKEN_EXPIRE_MINUTES=10
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30

# ── Two-Factor Authentication ─────────────────────────────────────────────────
# OTP_MODE=email  → a 6-digit code is emailed to the user at every login (default)
# OTP_MODE=totp   → the user must scan a provisioning URI with an authenticator app
OTP_MODE=email
SMTP_OTP_EXPIRE_MINUTES=10

# ── Email Delivery (Resend HTTPS API / SMTP Fallback) ────────────────────────
# Recommended: Resend HTTPS API (Never blocked by cloud firewalls / port restrictions)
# 1. Sign up at https://resend.com (free 3,000 emails/mo)
# 2. Get an API key (e.g. re_123456789...)
# 3. Use "Resume Screening <onboarding@resend.dev>" or your verified domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=Resume Screening <onboarding@resend.dev>

# Legacy SMTP fallback (used only if RESEND_API_KEY is left blank)
# Leave both blank for local dev — codes/reset URLs are printed to server logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@resumescreening.local
FRONTEND_URL=http://localhost:3000

# ── AI — Stage 2 LLM Evaluator ───────────────────────────────────────────────
# LLM_PROVIDER controls which scoring engine is used after semantic ranking:
#   heuristic  — free, deterministic keyword-match scoring (default, no API key needed)
#   gemini     — Gemini Flash via Google AI Studio (best quality; requires API key)
LLM_PROVIDER=heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Pipeline Config ────────────────────────────────────────────────────────────
STAGE1_TOP_N=10                 # candidates promoted from Stage 1 → Stage 2 LLM evaluation
MAX_PDF_SIZE_MB=5
MAX_ZIP_SIZE_MB=50
MAX_ZIP_UNCOMPRESSED_MB=250
MIN_SIMILARITY_SCORE=-1
