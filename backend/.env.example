# Copy this file to .env and fill in real values before running the server.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/resume_screening

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
TEMP_TOKEN_EXPIRE_MINUTES=10
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30

# ── Two-Factor Authentication ─────────────────────────────────────────────────
# OTP_MODE=email  → a 6-digit code is emailed to the user at every login (default)
# OTP_MODE=totp   → the user must scan a provisioning URI with an authenticator app
OTP_MODE=email
SMTP_OTP_EXPIRE_MINUTES=10

# ── Email Delivery (Gmail HTTPS API / SMTP Fallback) ─────────────────────────
# Recommended: Gmail HTTPS API via OAuth2 (no SMTP ports needed)
# 1. Create a project in Google Cloud Console → Enable Gmail API
# 2. Create OAuth 2.0 credentials (Web application type)
# 3. Use OAuth2 Playground or your own flow to get a refresh token
#    with scope: https://www.googleapis.com/auth/gmail.send
# 4. Set GMAIL_FROM_EMAIL to the Gmail address you authorized
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=yourname@gmail.com

# Legacy SMTP fallback (used only if Gmail credentials are left blank)
# Leave both blank for local dev — codes/reset URLs are printed to server logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@resumescreening.local
FRONTEND_URL=http://localhost:3000

# ── AI — Stage 2 LLM Evaluator ───────────────────────────────────────────────
# LLM_PROVIDER controls which scoring engine is used after semantic ranking:
#   heuristic  — free, deterministic keyword-match scoring (default, no API key needed)
#   gemini     — Gemini Flash via Google AI Studio (best quality; requires API key)
LLM_PROVIDER=heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Pipeline Config ────────────────────────────────────────────────────────────
STAGE1_TOP_N=10                 # candidates promoted from Stage 1 → Stage 2 LLM evaluation
MAX_PDF_SIZE_MB=5
MAX_ZIP_SIZE_MB=50
MAX_ZIP_UNCOMPRESSED_MB=250
MIN_SIMILARITY_SCORE=-1
